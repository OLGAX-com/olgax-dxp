PAYLOAD_SECRET=

# Local dev default (SQLite, zero external services). For a real deployment, set this to a
# postgres:// connection string (e.g. from Neon, Supabase, Railway, or Vercel Postgres) -
# payload.config.ts switches adapters automatically based on this value.
DATABASE_URL=file:./payload.db

# Only needed in production if @olgax/datasource's fetch-based resolvers run server-side
# (e.g. RelatedPages during SSR) - set to your deployed app's public URL.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: broader analytics (countries, sessions, devices, browsers, referrers) via a
# self-hosted Umami instance (see docker-compose.umami.yml). Leave unset to skip it - the
# built-in page-view counter on /dashboard keeps working either way with zero setup.
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=http://localhost:3001/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=replace-with-your-website-id
# NEXT_PUBLIC_UMAMI_DASHBOARD_URL=http://localhost:3001
